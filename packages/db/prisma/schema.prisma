generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity Core (shared by both apps) ─────────────────────────────────────

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  refresh_token_expires_in Int?
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   @db.Text // nullable: only set for Credentials users
  admin         Boolean   @default(false)
  // Nullable: backfilled lazily (not at migration time) — assigned the first time a user
  // without one is seen in the NextAuth jwt callback, so it covers existing users, new
  // Credentials signups and OAuth signups from one place. Format: CVA-<year>-<4 digits>.
  studentId     String?   @unique
  accounts      Account[]
  sessions      Session[]

  // Notes domain relations
  quizScores QuizScore[]

  // Video domain relations
  purchases              UserPurchases[]
  videoProgress          VideoProgress[]
  bookmarks              Bookmark[]
  comments               Comment[]
  questions              Question[]
  answers                Answer[]
  votes                  Vote[]
  certificates           Certificate[]
  bountySubmissions      BountySubmission[]
  paymentOrders          PaymentOrder[]
  internshipApplications InternshipApplication[]
  // Distinct from `certificates` (Certificate) above, which is a per-course completion
  // certificate tied to a real Course row. An internship isn't a Course, so this is its
  // own model — trackName is a plain string, not a foreign key.
  internshipCertificates InternshipCertificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Notes Domain ─────────────────────────────────────────────────────────────

model Track {
  id            String          @id @default(uuid())
  title         String
  description   String
  image         String
  categories    TrackCategory[]
  problems      TrackProblems[]
  inSearch      Boolean         @default(false)
  hidden        Boolean         @default(false)
  cohort        Int             @default(0)
  // Deprecated (superseded by `courses`/TrackCourse, a many-to-many combo-bundle
  // link) — kept, unused by app code, rather than dropped, since a production row
  // could still have this set. A later cleanup migration can remove it.
  courseId      String?         @unique
  course        Course?         @relation(fields: [courseId], references: [id])
  // Combo bundling: the courses this track unlocks on purchase, and what the
  // bundle itself costs. Null price (or no linked courses) means the track is
  // free — see hasTrackAccess() in lib/track-actions.ts.
  courses       TrackCourse[]
  bundlePrice   Float?
  paymentOrders PaymentOrder[]
  createdAt     DateTime        @default(now())
}

// Many-to-many: a track can bundle several courses, and a course can appear in
// more than one bundle. Paying a track's bundlePrice grants every course here.
model TrackCourse {
  track    Track  @relation(fields: [trackId], references: [id])
  trackId  String
  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  @@id([trackId, courseId])
  // trackId is already covered by the composite PK above (leftmost-prefix) — this
  // covers the reverse lookup, Course.trackBundles (e.g. deleteCourse's guard count).
  @@index([courseId])
}

model Categories {
  id       String          @id @default(uuid())
  category String
  tracks   TrackCategory[]
}

model TrackCategory {
  trackId    String
  track      Track      @relation(fields: [trackId], references: [id])
  categoryId String
  category   Categories @relation(fields: [categoryId], references: [id])

  @@id([trackId, categoryId])
}

model Problem {
  id            String          @id @default(uuid())
  title         String
  description   String
  // PPT-type only — the uploaded file's storage URL
  pptUrl        String?
  mcqQuestions  MCQQuestion[]
  type          ProblemType
  trackProblems TrackProblems[]
  quizScores    QuizScore[]
}

model TrackProblems {
  track        Track   @relation(fields: [trackId], references: [id])
  trackId      String
  problem      Problem @relation(fields: [problemId], references: [id])
  problemId    String
  sortingOrder Int

  @@id([trackId, problemId])
  // trackId covered by the composite PK (leftmost-prefix) — this covers deleting
  // a problem's own TrackProblems rows by problemId alone (see track-actions.ts).
  @@index([problemId])
}

model MCQQuestion {
  id            String   @id @default(uuid())
  question      String
  options       String[]
  correctOption String
  problem       Problem  @relation(fields: [problemId], references: [id])
  problemId     String
  // Questions are listed in the order they were added (ties broken by id).
  createdAt     DateTime @default(now())

  @@index([problemId])
}

model QuizScore {
  id        String   @id @default(uuid())
  score     Int
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  problem   Problem  @relation(fields: [problemId], references: [id])
  problemId String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([problemId])
}

enum ProblemType {
  MCQ
  PPT
}

// ─── Video Domain ─────────────────────────────────────────────────────────────

model Course {
  id                String                  @id @default(uuid())
  title             String
  description       String
  imageUrl          String?
  price             Float                   @default(0) // in INR (rupees) — Razorpay integration
  slug              String                  @unique
  hidden            Boolean                 @default(false)
  content           CourseContent[]
  purchases         UserPurchases[]
  certificate       Certificate[]
  paymentOrders     PaymentOrder[]
  // Deprecated 1:1 reverse side — see Track.courseId. Superseded by trackBundles.
  linkedTrack       Track?
  trackBundles      TrackCourse[] // combo bundles (Tracks) this course is included in
  internshipBundles InternshipTrackCourse[] // internship tracks this course is granted by
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model UserPurchases {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  // userId is already covered by the unique constraint above (leftmost-prefix) —
  // this covers getEnrolledStudents(courseId), a courseId-only filter.
  @@index([courseId])
}

// Razorpay payment audit trail — separate from UserPurchases (the access-check
// table) so every attempt (including failed/abandoned ones) is recorded for
// the client's records, without affecting access logic.
// Exactly one of courseId/trackId is set — app-enforced (see /api/razorpay/order),
// matching this schema's existing style of app-level invariants over DB constraints.
model PaymentOrder {
  id                String        @id @default(uuid())
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  user              User          @relation(fields: [userId], references: [id])
  userId            String
  course            Course?       @relation(fields: [courseId], references: [id])
  courseId          String?
  track             Track?        @relation(fields: [trackId], references: [id])
  trackId           String?
  amount            Float // in INR (rupees), matches Course.price or Track.bundlePrice at order-creation time
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([courseId])
  @@index([trackId])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

// Self-referential content tree: folders and leaves
model Content {
  id             String          @id @default(uuid())
  type           ContentType
  title          String
  hidden         Boolean         @default(false)
  description    String?
  thumbnail      String?
  // A Bunny Storage file path (PDF, JPG, JPEG or PNG) attached directly to this row —
  // for section-level materials (a FOLDER's cheatsheet, not tied to one specific video).
  // A VIDEO lesson's own material still lives on VideoMetadata.bunnyPdfPath; this field
  // covers FOLDER rows, which have no VideoMetadata. Served the same secure way, through
  // /api/notes/[contentId].
  materialPath   String?
  parentId       String?
  parent         Content?        @relation("ContentTree", fields: [parentId], references: [id])
  children       Content[]       @relation("ContentTree")
  courseContent  CourseContent[]
  videoMetadata  VideoMetadata?
  notionMetadata NotionMetadata?
  videoProgress  VideoProgress[]
  bookmarks      Bookmark[]
  comments       Comment[]
  questions      Question[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Self-referential tree traversal (building a subtree for cascading deletes,
  // see deleteCourse/deleteContent in lib/actions.ts) filters by parentId alone.
  @@index([parentId])
}

model CourseContent {
  course    Course  @relation(fields: [courseId], references: [id])
  courseId  String
  content   Content @relation(fields: [contentId], references: [id])
  contentId String
  order     Int

  @@id([courseId, contentId])
  // courseId covered by the composite PK (leftmost-prefix) — this covers the
  // reverse lookup from a Content row to its course (e.g. getBookmarks()).
  @@index([contentId])
}

model VideoMetadata {
  id            String  @id @default(uuid())
  // Nullable: a lesson can be Bunny-only (bunnyVideoId set, no Vercel Blob upload at all).
  // Existing lessons keep this set; the admin form still accepts a direct file upload too
  // — Bunny is an added option, not a replacement of the existing pipeline.
  videoUrl      String?
  drmProtected  Boolean @default(false)
  subtitleUrl   String?
  thumbnail1Url String?
  thumbnail2Url String?
  thumbnail3Url String?
  // Bunny Stream video ID — when set, the lesson page embeds the Bunny iframe player
  // instead of (or alongside) the plain <video> element above.
  bunnyVideoId  String?
  // Path of a PDF in Bunny Storage, served only through the authenticated/enrollment-
  // checked proxy at /api/notes/[contentId] — never a direct Bunny Storage URL.
  bunnyPdfPath  String?
  content       Content @relation(fields: [contentId], references: [id])
  contentId     String  @unique
}

model NotionMetadata {
  id        String  @id @default(uuid())
  notionId  String
  content   Content @relation(fields: [contentId], references: [id])
  contentId String  @unique
}

model VideoProgress {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  content    Content  @relation(fields: [contentId], references: [id])
  contentId  String
  markAsRead Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  // userId is already covered by the unique constraint below (leftmost-prefix) —
  // this covers deleteContent's cascading cleanup, a contentId-only filter.
  @@unique([userId, contentId])
  @@index([contentId])
}

model Bookmark {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   Content  @relation(fields: [contentId], references: [id])
  contentId String
  createdAt DateTime @default(now())

  // userId covered by the unique constraint below — this covers deleteContent's
  // cascading cleanup, a contentId-only filter.
  @@unique([userId, contentId])
  @@index([contentId])
}

model Comment {
  id        String      @id @default(uuid())
  content   Content     @relation(fields: [contentId], references: [id])
  contentId String
  author    User        @relation(fields: [authorId], references: [id])
  authorId  String
  body      String      @db.Text
  approved  Boolean     @default(false)
  type      CommentType @default(DEFAULT)
  votes     Vote[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([contentId])
}

model Question {
  id        String   @id @default(uuid())
  content   Content  @relation(fields: [contentId], references: [id])
  contentId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  title     String
  body      String   @db.Text
  answers   Answer[]
  votes     Vote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
}

model Answer {
  id         String   @id @default(uuid())
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  body       String   @db.Text
  accepted   Boolean  @default(false)
  votes      Vote[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}

model Vote {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  voteType   VoteType
  comment    Comment?  @relation(fields: [commentId], references: [id])
  commentId  String?
  question   Question? @relation(fields: [questionId], references: [id])
  questionId String?
  answer     Answer?   @relation(fields: [answerId], references: [id])
  answerId   String?

  @@index([commentId])
  @@index([questionId])
  @@index([answerId])
}

model Certificate {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  slug      String   @unique @default(uuid())
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  link        String?
  createdAt   DateTime  @default(now())
}

model BountySubmission {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  bountyId    String // external reference — linked in Phase 8
  description String   @db.Text
  type        PostType @default(BOUNTY)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A record of a submitted internship application, kept so an admin can see who applied
// before deciding whom to grant course access (see UserPurchases / grantCourseAccess) —
// granting is a deliberate, separate admin action, not automatic on submission.
// Still posted to the client's own Google Sheet from the browser (see lib/internships.ts);
// this table is this app's own copy, independent of that external system.
model InternshipApplication {
  id                 String           @id @default(uuid())
  user               User?            @relation(fields: [userId], references: [id])
  userId             String?
  fullName           String
  email              String
  phone              String
  usn                String
  college            String
  branch             String
  yearOfStudy        String
  // Deprecated free-text track name — kept (not dropped) for historical rows,
  // and because an admin may rename/delete the InternshipTrack catalog row
  // later without invalidating the record of what the applicant actually
  // picked at the time. New code should prefer internshipTrackId. Same
  // precedent as Track.courseId.
  internshipTrack    String
  internshipTrackId  String?
  internshipTrackRef InternshipTrack? @relation(fields: [internshipTrackId], references: [id], onDelete: SetNull)
  preferredDuration  String
  preferredStartDate String
  linkedIn           String
  resumeLink         String
  createdAt          DateTime         @default(now())
  // Admin-managed tracking, separate from the student's own preferredDuration/
  // preferredStartDate above (what they asked for at application time, left
  // untouched as a historical record). endDate isn't stored — it's always
  // startDate + durationMonths, computed where it's needed, so the two values
  // powering it can never drift apart in the database.
  startDate          DateTime?
  durationMonths     Int?
  // Temporarily suspends the internship without deleting the application or
  // touching any course access already granted via an issued certificate —
  // see revokeCertificate's own comment for why those are kept separate.
  frozen             Boolean          @default(false)

  @@index([internshipTrackId])
}

// An admin-issued internship completion certificate. certificateCode is the public,
// unguessable identifier embedded in the certificate's QR code and used by the public
// /verify/[certificateCode] route — never the row's own id, so verification works the
// same way slug-based lookups already do elsewhere (see Certificate.slug).
model InternshipCertificate {
  id                 String           @id @default(uuid())
  user               User             @relation(fields: [userId], references: [id])
  userId             String
  // Deprecated free-text track name — kept, see InternshipApplication's own
  // comment for why. Still always written so @@unique([userId, trackName])
  // keeps doing its existing duplicate-prevention job for old and new rows.
  trackName          String
  internshipTrackId  String?
  internshipTrackRef InternshipTrack? @relation(fields: [internshipTrackId], references: [id], onDelete: SetNull)
  issueDate          DateTime         @default(now())
  certificateCode    String           @unique @default(uuid())
  createdAt          DateTime         @default(now())

  @@unique([userId, trackName])
  // Confirmed hot path: deleteInternshipTrack's guard counts by internshipTrackId
  // alone before allowing a catalog track to be removed.
  @@index([internshipTrackId])
}

// Admin-managed internship track catalog — supersedes the former hardcoded
// INTERNSHIP_TRACKS array in lib/internships.ts. `duration` is a free-text,
// *advertised* duration only (e.g. "6-8 weeks") — distinct from each
// InternshipApplication's own admin-tracked startDate/durationMonths, which
// this does not touch.
model InternshipTrack {
  id           String                  @id @default(uuid())
  title        String
  duration     String
  description  String
  hidden       Boolean                 @default(false)
  courses      InternshipTrackCourse[]
  applications InternshipApplication[]
  certificates InternshipCertificate[]
  createdAt    DateTime                @default(now())
}

// Many-to-many: which paid courses an internship track grants when a
// certificate is issued for it — same composite-PK pattern as TrackCourse
// (combo bundles), just with no price (certificate grants are free, not sold).
model InternshipTrackCourse {
  track    InternshipTrack @relation(fields: [trackId], references: [id])
  trackId  String
  course   Course          @relation(fields: [courseId], references: [id])
  courseId String

  @@id([trackId, courseId])
  // trackId covered by the composite PK (leftmost-prefix) — this covers the
  // reverse lookup, Course.internshipBundles (deleteCourse's guard count).
  @@index([courseId])
}

enum ContentType {
  FOLDER
  VIDEO
  NOTION
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum CommentType {
  DEFAULT
  INTRO
}

enum PostType {
  BOUNTY
  PROJECT
}
