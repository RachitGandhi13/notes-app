# Matches docker-compose defaults — copy this file to .env (and to apps/web/.env,
# since Next.js only loads env files from the app directory) and fill in OAuth keys.
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform"
NEXTAUTH_SECRET="your-nextauth-secret"
# The site's own public URL — http://localhost:3000 in dev, the real domain in production
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vector search (Phase 7 — deferrable)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
GOOGLEAI_API_KEY=""
VECTOR_SIZE=768

# On-demand ISR revalidation
REVALIDATE_SECRET="your-revalidate-secret"

# Caching (Phase 8)
REDIS_URL="redis://localhost:6379"

# Razorpay (course purchases)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# From https://dashboard.razorpay.com/app/webhooks — used to verify the
# /api/razorpay/webhook durability backstop
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# SMTP (Phase 6 — register/password-reset/verification emails)
# Any SMTP provider works (Gmail app password, Outlook, etc.) — until this
# is set, sendEmail() just logs what it would have sent instead of failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
