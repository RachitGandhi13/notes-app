# Shared
# Matches docker-compose defaults — copy this file to .env and fill in OAuth keys
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vector search (Phase 7 — deferrable)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
GOOGLEAI_API_KEY=""
VECTOR_SIZE=768

# On-demand ISR revalidation (notes app)
REVALIDATE_SECRET="your-revalidate-secret"

# Caching (Phase 8)
REDIS_URL="redis://localhost:6379"

# Razorpay (video app only — course purchases)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# From https://dashboard.razorpay.com/app/webhooks — used to verify the
# /api/razorpay/webhook durability backstop
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Video app public URL
# In production set this to the deployed domain, e.g. https://learn.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Notes app → video app cross-link (Phase 3 topic bundling)
# Used by the notes app's paywall to link to the matching course's purchase
# page in the video app. In production set to the deployed video app domain.
NEXT_PUBLIC_VIDEO_APP_URL="http://localhost:3001"

# SMTP (Phase 6 — both apps, register/password-reset/verification emails)
# Any SMTP provider works (Gmail app password, Outlook, etc.) — until this
# is set, sendEmail() just logs what it would have sent instead of failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
