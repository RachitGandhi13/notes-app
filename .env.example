# Matches docker-compose defaults — copy this file to .env (and to apps/web/.env,
# since Next.js only loads env files from the app directory) and fill in OAuth keys.
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform"
NEXTAUTH_SECRET="your-nextauth-secret"
# The site's own public URL — http://localhost:3000 in dev, the real domain in production
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vector search (Phase 7 — deferrable)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
GOOGLEAI_API_KEY=""
VECTOR_SIZE=768

# On-demand ISR revalidation
REVALIDATE_SECRET="your-revalidate-secret"

# Caching (Phase 8). Required: the app refuses to start in production without it.
REDIS_URL="redis://localhost:6379"

# File uploads. Required in production (App Runner's disk is ephemeral, so
# uploads are refused without Vercel Blob). Leave empty in development to use public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Razorpay (course purchases)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_..."
# Same value as RAZORPAY_KEY_ID. Inlined into the browser bundle at build time,
# so Docker builds must pass it as --build-arg. It is a public key ID, not a secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# From https://dashboard.razorpay.com/app/webhooks — used to verify the
# /api/razorpay/webhook durability backstop
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# SMTP (register, password reset, verification). Required in production; in
# development, emails are printed to the terminal instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Production (AWS App Runner) ─────────────────────────────────────────────
# Set these in the App Runner service's environment, never in a file in the image.
# The server refuses to start if any is missing (see apps/web/lib/env.ts):
#   DATABASE_URL NEXTAUTH_URL NEXTAUTH_SECRET GITHUB_ID GITHUB_SECRET
#   GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET SMTP_HOST SMTP_USER SMTP_PASS SMTP_FROM
#   RAZORPAY_KEY_ID RAZORPAY_KEY_SECRET RAZORPAY_WEBHOOK_SECRET
#   BLOB_READ_WRITE_TOKEN REDIS_URL REVALIDATE_SECRET
# NEXT_PUBLIC_RAZORPAY_KEY_ID is a Docker build argument, not a runtime variable.
